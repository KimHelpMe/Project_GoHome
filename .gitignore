# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Locally packaged builds (UAT BuildCookRun -archivedirectory output)
Packaged/

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# JetBrains Rider project files
.idea/
*.DotSettings.user

# Claude Code local (personal) settings
.claude/settings.local.json

# Codex local (personal) skills
.agents/skills/

# 개인용 자동화 스킬 (미검증, 아직 팀 공유 안 함)
.claude/skills/24x7-dev-loop/
.claude/skills/feature-loop/
.claude/skills/ui-reference-pack/
.claude/skills/LOOP_CORE.md
.claude/skills/ENGINE_BINDING_UE5.md
.claude/skills/PROJECT_BINDING.md
.claude/skills/AGENT_BINDING_CODEX.md

# 개인 작업 문서 (담당자별 스크래치 — 팀 공유 아님)
/Docs/Dev/_personal/

# UI Reference Pack 산출물 (개인 작업 영역 — 팀 공유 아님)
/Docs/Dev/UI/

# 문서 검색 인덱스 캐시 (로컬 생성 아티팩트, 소스 아님)
/Docs/index.bleve/

